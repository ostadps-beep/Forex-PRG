<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Color.App.Background" Color="#181A1F"/>
  <SolidColorBrush x:Key="Color.App.Foreground" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Color.App.TitleBar" Color="#15171B"/>
  <SolidColorBrush x:Key="Color.App.TitleBarHover" Color="#252930"/>
  <SolidColorBrush x:Key="Color.App.TitleBarPressed" Color="#30353E"/>
  <SolidColorBrush x:Key="Color.App.TitleBarButtonForeground" Color="#D8DCE2"/>
  <SolidColorBrush x:Key="Color.App.TitleBarCloseHover" Color="#C42B2B"/>
  <SolidColorBrush x:Key="Color.App.TitleBarClosePressed" Color="#A52222"/>
  <SolidColorBrush x:Key="Color.Toolbar.Background" Color="#20232A"/>
  <SolidColorBrush x:Key="Color.Toolbar.Border" Color="#3C414A"/>
  <SolidColorBrush x:Key="Color.Toolbar.GroupBackground" Color="#292D35"/>
  <SolidColorBrush x:Key="Color.Toolbar.GroupBorder" Color="#4A505A"/>
  <SolidColorBrush x:Key="Color.Toolbar.Icon" Color="#D8DCE2"/>
  <SolidColorBrush x:Key="Color.Toolbar.IconLight" Color="#F0F2F5"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonHover" Color="#30353E"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonHoverBorder" Color="#525A66"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonPressed" Color="#3B424D"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonPressedBorder" Color="#697381"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButton" Color="#2E3946"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonHover" Color="#3A4A5D"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonPressed" Color="#465B72"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonBorder" Color="#60758C"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonIcon" Color="#DCE8F5"/>
  <SolidColorBrush x:Key="Color.Chart.Background" Color="#101216"/>
  <SolidColorBrush x:Key="Color.Chart.Border" Color="#40454E"/>
  <SolidColorBrush x:Key="Color.Chart.Grid" Color="#3A3F48"/>
  <SolidColorBrush x:Key="Color.Chart.Axis" Color="#8A909B"/>
  <SolidColorBrush x:Key="Color.Chart.Text" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Color.Chart.Crosshair" Color="#B0B0B0"/>
  <SolidColorBrush x:Key="Color.Chart.CandleUp" Color="#4CAF50"/>
  <SolidColorBrush x:Key="Color.Chart.CandleDown" Color="#EF5350"/>
  <SolidColorBrush x:Key="Color.Chart.WickUp" Color="#4CAF50"/>
  <SolidColorBrush x:Key="Color.Chart.WickDown" Color="#EF5350"/>
  <SolidColorBrush x:Key="Color.Chart.Volume" Color="#607D8B"/>
  <SolidColorBrush x:Key="Color.Panel.Background" Color="#20232A"/>
  <SolidColorBrush x:Key="Color.Panel.Border" Color="#4A505A"/>
  <SolidColorBrush x:Key="Color.Panel.Text" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Color.Control.Background" Color="#292D35"/>
  <SolidColorBrush x:Key="Color.Control.Border" Color="#505762"/>
  <SolidColorBrush x:Key="Color.Control.Foreground" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Color.Control.Disabled" Color="#777E89"/>
  <SolidColorBrush x:Key="Color.Control.Hover" Color="#30353E"/>
  <SolidColorBrush x:Key="Color.Control.Pressed" Color="#3B424D"/>
  <SolidColorBrush x:Key="Color.Control.Selection" Color="#465B72"/>
  <SolidColorBrush x:Key="Menu.Static.Background" Color="#20232A"/>
  <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="#20232A"/>
  <SolidColorBrush x:Key="Menu.Static.Border" Color="#4A505A"/>
  <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="Menu.Static.Separator" Color="#4A505A"/>
  <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#777E89"/>
  <ControlTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=SubmenuContent}" TargetType="ContentControl">
    <Border Background="{DynamicResource Menu.Static.Background}" BorderBrush="{DynamicResource Menu.Static.Border}" BorderThickness="1">
      <ContentPresenter/>
    </Border>
  </ControlTemplate>
  <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#465B72"/>
  <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#60758C"/>
  <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#30353E"/>
  <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#525A66"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#292D35"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#292D35"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#20232A"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#30353E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#465B72"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Color.App.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.App.Foreground}"/>
  </Style>
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Static.Foreground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Static.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Menu.Static.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Separator}"/>
    <Setter Property="Margin" Value="6,3"/>
    <Setter Property="Height" Value="1"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Toolbar.ButtonHoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Pressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Selection}"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <ToggleButton Grid.Column="1" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent" BorderThickness="0">
                  <Path Data="M2,2 L6,6 L10,2" Width="10" Height="6" Stretch="Fill" Stroke="{DynamicResource Color.Control.Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Color.Control.Background}" BorderBrush="{DynamicResource Color.Control.Border}" BorderThickness="1" CornerRadius="3" Padding="2">
                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Color.Toolbar.ButtonHoverBorder}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
  </Style>
</ResourceDictionary>