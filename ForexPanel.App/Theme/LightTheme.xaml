<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Color.App.Background" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Color.App.Foreground" Color="#202020"/>
  <SolidColorBrush x:Key="Color.App.TitleBar" Color="#E9E9E9"/>
  <SolidColorBrush x:Key="Color.App.TitleBarHover" Color="#DCDCDC"/>
  <SolidColorBrush x:Key="Color.App.TitleBarPressed" Color="#CECECE"/>
  <SolidColorBrush x:Key="Color.App.TitleBarButtonForeground" Color="#303030"/>
  <SolidColorBrush x:Key="Color.App.TitleBarCloseHover" Color="#E81123"/>
  <SolidColorBrush x:Key="Color.App.TitleBarClosePressed" Color="#C50F1F"/>
  <SolidColorBrush x:Key="Color.Toolbar.Background" Color="#F4F4F4"/>
  <SolidColorBrush x:Key="Color.Toolbar.Border" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="Color.Toolbar.GroupBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Color.Toolbar.GroupBorder" Color="#CDCDCD"/>
  <SolidColorBrush x:Key="Color.Toolbar.Icon" Color="#303030"/>
  <SolidColorBrush x:Key="Color.Toolbar.IconLight" Color="#707070"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonHover" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonHoverBorder" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonPressed" Color="#D4D4D4"/>
  <SolidColorBrush x:Key="Color.Toolbar.ButtonPressedBorder" Color="#909090"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButton" Color="#DCE6F2"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonHover" Color="#C7D9EC"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonPressed" Color="#B0C8E2"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonBorder" Color="#9FB5CC"/>
  <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonIcon" Color="#29445F"/>
  <SolidColorBrush x:Key="Color.Chart.Background" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Color.Chart.Border" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="Color.Chart.Grid" Color="#D9DDE2"/>
  <SolidColorBrush x:Key="Color.Chart.Axis" Color="#60656D"/>
  <SolidColorBrush x:Key="Color.Chart.Text" Color="#202020"/>
  <SolidColorBrush x:Key="Color.Chart.Crosshair" Color="#707070"/>
  <SolidColorBrush x:Key="Color.Chart.CandleUp" Color="#2E8B57"/>
  <SolidColorBrush x:Key="Color.Chart.CandleDown" Color="#D64545"/>
  <SolidColorBrush x:Key="Color.Chart.WickUp" Color="#2E8B57"/>
  <SolidColorBrush x:Key="Color.Chart.WickDown" Color="#D64545"/>
  <SolidColorBrush x:Key="Color.Chart.Volume" Color="#78909C"/>
  <SolidColorBrush x:Key="Color.Panel.Background" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Color.Panel.Border" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="Color.Panel.Text" Color="#202020"/>
  <SolidColorBrush x:Key="Color.Control.Background" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Color.Control.Border" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="Color.Control.Foreground" Color="#202020"/>
  <SolidColorBrush x:Key="Color.Control.Disabled" Color="#909090"/>
  <SolidColorBrush x:Key="Color.Control.Hover" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Color.Control.Pressed" Color="#D4D4D4"/>
  <SolidColorBrush x:Key="Color.Control.Selection" Color="#C7D9EC"/>
  <SolidColorBrush x:Key="Menu.Static.Background" Color="#F4F4F4"/>
  <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="#F4F4F4"/>
  <SolidColorBrush x:Key="Menu.Static.Border" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#202020"/>
  <SolidColorBrush x:Key="Menu.Static.Separator" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="Menu.Disabled.Foreground" Color="#909090"/>
  <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#C7D9EC"/>
  <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#9FB5CC"/>
  <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#B8B8B8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#202020"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#202020"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F4F4F4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#202020"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C7D9EC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#202020"/>
  <ControlTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=SubmenuContent}" TargetType="ContentControl">
    <Border Background="{DynamicResource Menu.Static.Background}" BorderBrush="{DynamicResource Menu.Static.Border}" BorderThickness="1">
      <ContentPresenter/>
    </Border>
  </ControlTemplate>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Color.App.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.App.Foreground}"/>
  </Style>
  <Style TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Static.Foreground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Static.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Menu.Static.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Menu.Static.Separator}"/>
    <Setter Property="Margin" Value="6,3"/>
    <Setter Property="Height" Value="1"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Toolbar.ButtonHoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Pressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Hover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Color.Control.Selection}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <ToggleButton Grid.Column="1" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent" BorderThickness="0">
                  <Path Data="M2,2 L6,6 L10,2" Width="10" Height="6" Stretch="Fill" Stroke="{DynamicResource Color.Control.Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Color.Control.Background}" BorderBrush="{DynamicResource Color.Control.Border}" BorderThickness="1" CornerRadius="3" Padding="2">
                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Color.Toolbar.ButtonHoverBorder}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Color.Control.Border}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource Color.Control.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Color.Control.Foreground}"/>
  </Style>
</ResourceDictionary>