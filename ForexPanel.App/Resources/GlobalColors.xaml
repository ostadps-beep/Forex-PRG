    <SolidColorBrush x:Key="Color.App.TitleBar" Color="#15171B"/>
    <SolidColorBrush x:Key="Color.App.TitleBarHover" Color="#252930"/>
    <SolidColorBrush x:Key="Color.App.TitleBarPressed" Color="#30353E"/>
    <SolidColorBrush x:Key="Color.App.TitleBarButtonForeground" Color="#D8DCE2"/>
    <SolidColorBrush x:Key="Color.App.TitleBarCloseHover" Color="#C42B2B"/>
    <SolidColorBrush x:Key="Color.App.TitleBarClosePressed" Color="#A52222"/>

    <SolidColorBrush x:Key="Color.Toolbar.Background" Color="#20232A"/>
    <SolidColorBrush x:Key="Color.Toolbar.Border" Color="#3C414A"/>
    <SolidColorBrush x:Key="Color.Toolbar.GroupBackground" Color="#292D35"/>
    <SolidColorBrush x:Key="Color.Toolbar.GroupBorder" Color="#4A505A"/>
    <SolidColorBrush x:Key="Color.Toolbar.Icon" Color="#D8DCE2"/>
    <SolidColorBrush x:Key="Color.Toolbar.IconLight" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="Color.Toolbar.ButtonHover" Color="#30353E"/>
    <SolidColorBrush x:Key="Color.Toolbar.ButtonHoverBorder" Color="#525A66"/>
    <SolidColorBrush x:Key="Color.Toolbar.ButtonPressed" Color="#3B424D"/>
    <SolidColorBrush x:Key="Color.Toolbar.ButtonPressedBorder" Color="#697381"/>
    <SolidColorBrush x:Key="Color.Toolbar.CollapseButton" Color="#2E3946"/>
    <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonHover" Color="#3A4A5D"/>
    <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonPressed" Color="#465B72"/>
    <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonBorder" Color="#60758C"/>
    <SolidColorBrush x:Key="Color.Toolbar.CollapseButtonIcon" Color="#DCE8F5"/>

    <SolidColorBrush x:Key="Color.Chart.Background" Color="#101216"/>
    <SolidColorBrush x:Key="Color.Chart.Border" Color="#40454E"/>
    <SolidColorBrush x:Key="Color.Chart.Grid" Color="#30343B"/>
    <SolidColorBrush x:Key="Color.Chart.Axis" Color="#8A909B"/>
    <SolidColorBrush x:Key="Color.Chart.Text" Color="#E0E0E0"/>
