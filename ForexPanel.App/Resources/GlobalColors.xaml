    <SolidColorBrush x:Key="Color.Chart.Volume" Color="#607D8B"/>

    <SolidColorBrush x:Key="Color.Panel.Background" Color="#20232A"/>
    <SolidColorBrush x:Key="Color.Panel.Border" Color="#4A505A"/>
    <SolidColorBrush x:Key="Color.Panel.Text" Color="#F0F0F0"/>

    <SolidColorBrush x:Key="Color.Control.Background" Color="#292D35"/>
    <SolidColorBrush x:Key="Color.Control.Border" Color="#505762"/>
    <SolidColorBrush x:Key="Color.Control.Foreground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Color.Control.Disabled" Color="#777E89"/>
    <SolidColorBrush x:Key="Color.Control.Hover" Color="#30353E"/>
    <SolidColorBrush x:Key="Color.Control.Pressed" Color="#3B424D"/>
    <SolidColorBrush x:Key="Color.Control.Selection" Color="#465B72"/>
