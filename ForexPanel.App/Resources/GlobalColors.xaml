<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      This dictionary used to duplicate every color key from Theme/DarkTheme.xaml with its own
      hardcoded values, which had already drifted out of sync in at least one place
      (Color.Chart.Grid differed between the two files). It is merged in App.xaml as a
      startup fallback, before ThemeManager.Apply() runs in MainWindow's constructor and
      replaces these with the real Light/Dark/System theme. To avoid two sources of truth for
      the same colors, it now simply merges DarkTheme.xaml as that fallback instead of
      redefining the colors itself. See docs/STATUS_CHECKLIST.md item 28.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ForexPanel.App;component/Theme/DarkTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
